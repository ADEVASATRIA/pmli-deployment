# Frontend VM (pmli-app-02-frontend) settings. Copy to env/frontend.env (git-ignored).
# NON-SECRET values only.
#
# This repo previously had NO frontend deployment config at all (see README.md:
# "The frontend domain is managed elsewhere") - none of the values below could be
# confirmed from existing repo content. Confirm every one against the real Frontend
# VM before running scripts/06-update-frontend-nginx.sh for the first time; the
# script refuses to run with any of the required ones still empty rather than guess.

EXPECTED_HOSTNAME=pmli-app-02-frontend

# NOT confirmed from this repo - fill in only once known. Informational only (hostname
# sanity, matches the convention of API_PRIVATE_IP in env/api.env); the Nginx config
# itself does not need this value, so it is not required by the script.
FRONTEND_PRIVATE_IP=

FRONTEND_DOMAIN=lms.pmli.co.id

# NOT confirmed from this repo - the production build's web root (e.g. a Vite/Vue
# `dist/` directory), NOT guessed or hardcoded. Must already exist and contain
# index.html; scripts/06-update-frontend-nginx.sh fails fast otherwise.
FRONTEND_DIR=

# The API VM's already-working private endpoint (see docs/DEPLOYMENT_RUNBOOK.md -
# Frontend VM -> API VM over HTTP is confirmed working). Keep in sync with
# env/api.env's own API_PRIVATE_IP; this repo does not read that file to cross-check.
API_PRIVATE_IP=192.168.50.50
API_PRIVATE_PORT=80

# TLS for lms.pmli.co.id. nginx/lms.pmli.co.id.conf ASSUMES TLS terminates at this
# Nginx (same one-block, two-listener pattern as nginx/api-lms.pmli.co.id.conf) -
# confirm this is actually true for the Frontend VM (vs. e.g. a load balancer/CDN
# terminating TLS in front of it) before relying on it; see the note at the top of
# nginx/lms.pmli.co.id.conf and docs/DEPLOYMENT_RUNBOOK.md's Frontend VM section.
# Left empty = scripts/06-update-frontend-nginx.sh refuses to run rather than guess.
FRONTEND_TLS_CERT_PATH=
FRONTEND_TLS_KEY_PATH=
