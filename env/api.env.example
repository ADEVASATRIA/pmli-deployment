# API VM (pmli-app-01-api) settings. Copy to env/api.env (git-ignored).
# NON-SECRET values only. Laravel's own .env lives in APP_DIR, not here.

EXPECTED_HOSTNAME=pmli-app-01-api
API_PRIVATE_IP=192.168.50.50
DB_PRIVATE_IP=192.168.50.55
APP_DOMAIN=api-lms.pmli.co.id
APP_DIR=/var/www/pmli-backend
PHP_VERSION=8.3
WEB_USER=www-data
WEB_GROUP=www-data

# TLS files already provisioned on the API VM for api-lms.pmli.co.id (this repo never
# issues or modifies them - see docs/DEPLOYMENT_RUNBOOK.md Phase J). 03-deploy-app.sh
# fails fast if either path does not exist rather than installing a broken TLS site.
TLS_CERT_PATH=/etc/ssl/pmli/fullchain.crt
TLS_KEY_PATH=/etc/ssl/pmli/private.key

# Ubuntu 22.04 does not ship PHP 8.3. 02-setup-api.sh will only add the
# third-party PPA ppa:ondrej/php if you consent here (or pass --allow-php-ppa).
ALLOW_PHP_PPA=no
