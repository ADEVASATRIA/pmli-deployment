# DB VM (pmli-db-01) settings. Copy to env/db.env (git-ignored) and adjust.
# NON-SECRET values only.
#
# DB_APP_PASSWORD is intentionally NOT listed with a value here.
# Supply it at runtime, never commit it:
#   sudo DB_APP_PASSWORD='...' ./scripts/01-setup-db.sh
# or omit it and the script will prompt for it (input hidden), or put it in
# your git-ignored env/db.env (chmod 600).

EXPECTED_HOSTNAME=pmli-db-01
DB_BIND_ADDRESS=192.168.50.55
API_PRIVATE_IP=192.168.50.50
DB_NAME=pmli_lms
DB_APP_USER=pmli_app
